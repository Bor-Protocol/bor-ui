# BOR UI Environment Variables

# Google OAuth Configuration (get from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# API Endpoints
VITE_BOR_SERVER_URL=http://localhost:6969
VITE_PROTOCOL_API_URL=http://localhost:3000

# Development Settings
VITE_NODE_ENV=development

# Instructions:
# 1. Copy this file to .env.local
# 2. Set up Google OAuth:
#    - Go to https://console.cloud.google.com/
#    - Create a new project or select existing
#    - Enable Google Identity Services API
#    - Create OAuth 2.0 credentials
#    - Add your domain to authorized origins
#    - Copy Client ID and paste above
# 3. Update API URLs if running on different ports